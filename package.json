{
  "name": "ai-act-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Diagnóstico local y trazable del AI Act: cuestionario, evidencias y motor determinista.",
  "license": "MIT",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "local": "npm run build && tsx src/server/main.ts",
    "dev": "tsx src/server/main.ts --dev",
    "cli": "tsx src/cli/main.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "catalog:validate": "tsx src/cli/main.ts catalog validate",
    "scenarios:test": "tsx src/cli/main.ts scenarios test"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0",
    "docx": "^9.0.0",
    "pdfkit": "^0.17.0",
    "lucide-react": "^0.468.0",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/pdfkit": "^0.17.0",
    "vitest": "^3.2.0",
    "@playwright/test": "^1.55.0"
  }
}
